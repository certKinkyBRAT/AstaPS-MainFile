/* 九档物品 ID、数量区间、冒险阅历与好感经验已与 7.1 资源快照
 * BlossomRefresh.dropVec -> DropTable 逐项核对，20/20 档位比较一致。
 * 原始客户端的世界等级映射及随机解释尚未独立证明，资源原始性亦待验证。
 * 本文件是 AstaPS 发奖权威；详见 docs/rewards/source-provenance.md。 */

/* ========================================================================== */
/* 地脉：基础经验、藏金之花、启示之花 */
/* ========================================================================== */

/* 每次领取地脉之花固定获得 100 冒险阅历。 */
blossom {
    genshin.experience.adventure: 1250;
}

/* 藏金之花：世界等级 WR 决定摩拉和好感经验。 */


blossom[type="wealth"] {
    &[WR=0] {
        genshin.currency.mora: 12000;
        genshin.currency.primogem: 25;
        genshin.experience.companionship: 10;
    }

    &[WR=1] {
        genshin.currency.mora: 25000;
        genshin.currency.primogem: 50;
        genshin.experience.companionship: 15;
    }

    &[WR=2] {
        genshin.currency.mora: 50000;
        genshin.currency.primogem: 75;
        genshin.experience.companionship: 15;
    }

    &[WR=3] {
        genshin.currency.mora: 75000;
        genshin.currency.primogem: 100;
        genshin.experience.companionship: 15;
    }

    &[WR=4] {
        genshin.currency.mora: 100000;
        genshin.currency.primogem: 125;
        genshin.experience.companionship: 15;
    }

    &[WR=5] {
        genshin.currency.mora: 125000;
        genshin.currency.primogem: 150;
        genshin.experience.companionship: 20;
    }

    &[WR=6] {
        genshin.currency.mora: 150000;
        genshin.currency.primogem: 175;
        genshin.experience.companionship: 20;
    }

    &[WR=7] {
		genshin.currency.mora: 175000;
		genshin.currency.primogem: 225;
		genshin.experience.companionship: 20;
	}

	&[WR=8] {
		genshin.currency.mora: 200000;
		genshin.currency.primogem: 250;
		genshin.experience.companionship: 20;
	}

	&[WR=9] {
		genshin.currency.mora: 225000;
		genshin.currency.primogem: 275;
		genshin.experience.companionship: 20;
	}
}


/* 启示之花：经验书数量独立抽样，范围含两端。 */

blossom[type="revelation"] {
    &[WR=0] {
        genshin.avatar_up.wanderers_advice: "7~8";
        genshin.avatar_up.adventurers_experience: "3~4";
        genshin.weapon_up.mystic_ore: 5;
        genshin.experience.companionship: 10;
    }

    &[WR=1] {
        genshin.avatar_up.wanderers_advice: "10~12";
        genshin.avatar_up.adventurers_experience: "5~6";
        genshin.weapon_up.mystic_ore: 5;
        genshin.experience.companionship: 15;
    }

    &[WR=2] {
        genshin.avatar_up.adventurers_experience: "10~11";
        genshin.weapon_up.mystic_ore: 10;
        genshin.experience.companionship: 15;
    }

    &[WR=3] {
        genshin.avatar_up.adventurers_experience: "13~14";
        genshin.weapon_up.mystic_ore: 10;
        genshin.experience.companionship: 15;
    }

    &[WR=4] {
        genshin.avatar_up.adventurers_experience: "6~7";
        genshin.avatar_up.heros_wit: "2~3";
        genshin.weapon_up.mystic_ore: 15;
        genshin.experience.companionship: 15;
    }

    &[WR=5] {
        genshin.avatar_up.adventurers_experience: "6~7";
        genshin.avatar_up.heros_wit: "3~4";
        genshin.weapon_up.mystic_ore: 15;
        genshin.experience.companionship: 20;
    }

    &[WR=6] {
        genshin.avatar_up.adventurers_experience: "6~7";
        genshin.avatar_up.heros_wit: "4~5";
        genshin.weapon_up.mystic_ore: 20;
        genshin.experience.companionship: 20;
    }

    &[WR=7] {
        genshin.avatar_up.adventurers_experience: "6~7";
        genshin.avatar_up.heros_wit: "5~6";
        genshin.weapon_up.mystic_ore: 20;
        genshin.experience.companionship: 20;
    }

    &[WR=8] {
        genshin.avatar_up.adventurers_experience: "6~7";
        genshin.avatar_up.heros_wit: "6~7";
        genshin.weapon_up.mystic_ore: 25;
        genshin.experience.companionship: 20;
    }

    &[WR=9] {
        genshin.avatar_up.adventurers_experience: "6~7";
        genshin.avatar_up.heros_wit: "7~8";
        genshin.weapon_up.mystic_ore: 25;
        genshin.experience.companionship: 20;
    }
}
